[general]
metadata = $CONFIG_PATH/metadata
accounts = backup
maxsyncaccounts = 1
ui = basic
socktimeout = 120

[Account backup]
localrepository = backup-local
remoterepository = backup-remote
autorefresh = 15
quick = 10

[Repository backup-local]
type = Maildir
localfolders = $MAIL_PATH/user@example.org

[Repository backup-remote]
type = IMAP
remotehost = mail.example.org
remoteuser = user@example.org
remotepassfile = password
ssl = yes
starttls = no
sslcacertfile = OS-DEFAULT
remoteport = 993
readonly = true
sync_deletes = no
